# Keep only source scripts, reproducible inputs, and project metadata.
*
!.gitignore
!requirements.txt

# Keep source code in every project folder.
!*/
!**/*.py

# Keep tabular inputs (generated Kc curves remain ignored).
!Kc Map/cropwise_Kc.csv
!Kc Map/Kc_FAO56.csv
!Rooting Depth/Rooting Depth FAO56.csv
!Well Depth Map/*.csv
!**/Updated Watershed/**/*
!**/Crop Maps/**/*
!Kc Map/CropMap_Kharif_2024-25_new.tif
!Kc Map/CropMap_Rabi_2024-25_new.tif
!Rooting Depth/CropMap_Kharif_2024-25_new.tif
!Rooting Depth/CropMap_Rabi_2024-25_new.tif
!Well Depth Map/*.asc

# Python environments and generated Python files.
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class

# Generated GIS, scientific-data, and visualization products.
*.nc
*.tif.aux.xml
*.qgz
*.qml
*.clr
*.png
*.mp4